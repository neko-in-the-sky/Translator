{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%\\Translator\\Logs\\log-.txt",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 10
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "SearchEngines": [
      {
        "Name": "Oxford",
        "UrlTemplate": "https://www.oxfordlearnersdictionaries.com/search/english/?q={0}",
        "IconFileName": "oxford.ico",
        "Hide": [ "#ox-header", "#searchbar", "#ox-footer", "[id^=\"ad_\"]", "#ring-links-box", ".definition-title", ".wotd-box.opal_written" ],
        "AutoSearchRegex": "^[a-zA-Z]+(?:[-'’ ][a-zA-Z]+){0,3}$"
      },
      {
        "Name": "Free Dictionary",
        "UrlTemplate": "https://www.thefreedictionary.com/{0}",
        "IconFileName": "free_dictionary.ico",
        "Hide": [ "#header", "[id^=\"yk\"]", ".TopBannerAd", ".afs_ads", "#fixedBlock" ],
        "AutoSearchRegex": "^[a-zA-Z]+(?:[-'’ ][a-zA-Z]+){0,3}$"
      },
      {
        "Name": "Multitran",
        "UrlTemplate": "https://www.multitran.com/m.exe?l1=1&l2=2&s={0}",
        "IconFileName": "multitran.ico",
        "Hide": [ ".container > div:has(> .offset1)", ".container > div:has(> .menu1)", "#translation","div:has(> .small > a[title=\"Google\"])", "table:has(a[name=\"phrases\"])", "table:has(td.phras)", "div.grayline" ],
        "AutoSearchRegex": "^[a-zA-Z]+(?:[-'’ ][a-zA-Z]+){0,3}$"
      },
      {
        "Name": "Google Translate",
        "UrlTemplate": "https://translate.google.com/?sl=auto&tl=en&text={0}&op=translate",
        "IconFileName": "google_translate.ico",
        "Hide": [ "header[role=\"banner\"]", "nav" ],
        "AutoSearchRegex": "^(?!.*(?:[\\p{L}\\p{M}]\\p{P}*\\p{N}|\\p{N}\\p{P}*\\p{L}))[\\p{L}\\p{M}\\p{N}\\p{P} -[#%&*/\\\\@_\\[\\]{}]]{1,200}$"
      },
      {
        "Name": "Urban Dictionary",
        "UrlTemplate": "https://www.urbandictionary.com/define.php?term={0}",
        "IconFileName": "urban_dictionary.ico",
        "Hide": [ "#ud-root > div:has(> div > [class~=\"leaderboard:block\"])", ".udh", "#definitions-feed > section", ".ad-panel", ".definition div:has(> a[href*=\"/go/store/\"])", "footer.udf" ],
        "AutoSearchRegex": "^[a-zA-Z]+(?:[-'’ ][a-zA-Z]+){0,3}$"
      },
      {
        "Name": "Wiktionary English",
        "UrlTemplate": "https://en.wiktionary.org/wiki/{0}#English",
        "IconFileName": "uk_flag.ico",
        "Hide": [ ".vector-header-container", ".vector-sticky-header", ".vector-page-toolbar", "#p-lang-btn", "#catlinks", ".mw-footer-container", ".interproject-box" ],
        "AutoSearchRegex": "^[a-zA-Z]+(?:[-'’ ][a-zA-Z]+){0,3}$"
      },
      {
        "Name": "Wiktionary Spanish",
        "UrlTemplate": "https://en.wiktionary.org/wiki/{0}#Spanish",
        "IconFileName": "spain_flag.ico",
        "Hide": [ ".vector-header-container", ".vector-sticky-header", ".vector-page-toolbar", "#p-lang-btn", "#catlinks", ".mw-footer-container", ".interproject-box" ],
        "AutoSearchRegex": "^\\p{L}+(?:[-'’ ]\\p{L}+){0,3}$"
      },
      {
        "Name": "Wiktionary German",
        "UrlTemplate": "https://en.wiktionary.org/wiki/{0}#German",
        "IconFileName": "germany_flag.ico",
        "Hide": [ ".vector-header-container", ".vector-sticky-header", ".vector-page-toolbar", "#p-lang-btn", "#catlinks", ".mw-footer-container", ".interproject-box" ],
        "AutoSearchRegex": "^\\p{L}+(?:[-'’ ]\\p{L}+){0,3}$"
      }
    ],
    "UserSettings": {
      "DefaultSearchEngine": "Oxford",
      "AllowedFullscreenApps": [
        "firefox",
        "foxit",
        "explorer",
        "translator"
      ],
      "Culture": "en-US",
      "Popup": {
        "DefaultWidth": 650,
        "DefaultHeight": 500,
        "VerticalOffsetFromCursor": 25
      }
    }
  }
}