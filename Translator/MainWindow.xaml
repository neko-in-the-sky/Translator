<Window
    x:Class="Translator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:Translator.Properties"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:translator="clr-namespace:Translator"
    Title="{x:Static p:Resources.MainWindow_Title}"
    Width="650"
    Height="500"
    Deactivated="Window_Deactivated"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    d:DataContext="{d:DesignInstance Type=translator:MainWindowViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <!-- Extending the glass frame, even by a pixel, is what makes the Desktop Window Manager draw its shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            GlassFrameThickness="1"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Popup.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Where Windows rounds the corners it also draws a thin border, and this one is removed. -->
    <Border Name="WindowBorder" BorderBrush="Black" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <tb:TaskbarIcon
                IconSource="/icons/stack-of-books.ico"
                MenuActivation="LeftOrRightClick"
                ToolTipText="{x:Static p:Resources.TrayIcon_TooltipText}"
                Visibility="Visible">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItemTranslate_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_Translate}" />
                        <Separator />
                        <MenuItem Click="MenuItemOpenFolder_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_OpenFolder}" />
                        <MenuItem Click="MenuItemOpenSettingsFolder_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_OpenSettingsFolder}" />
                        <MenuItem Click="MenuItemOpenLogsFolder_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_OpenLogsFolder}" />
                        <MenuItem Click="MenuItemExit_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_Exit}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- The toolbar, with a divider under it. The page below runs to the window's edges. -->
            <Border
                Grid.Row="0"
                Padding="12,12,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Name="QueryTextBox"
                        Grid.Column="0"
                        KeyDown="QueryTextBox_KeyDown"
                        Style="{StaticResource SearchBoxStyle}"
                        Tag="{x:Static p:Resources.QueryTextBox_Placeholder}"
                        Text="{Binding Path=QueryText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{x:Static p:Resources.QueryTextBox_Tooltip}" />

                    <!-- The engine buttons, grouped. The highlighted one is the engine whose page is showing. -->
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="1,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource SubtleFillBrush}"
                        CornerRadius="6">
                        <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding SearchCommands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="1,0"
                                        AutomationProperties.Name="{Binding ToolTip}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource EngineButtonStyle}"
                                        ToolTip="{Binding ToolTip}">
                                        <Image
                                            Width="20"
                                            Height="20"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding IconFilePath}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <wpf:WebView2
                Name="WebBrowser"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Visible">
            </wpf:WebView2>
        </Grid>
    </Border>
</Window>
