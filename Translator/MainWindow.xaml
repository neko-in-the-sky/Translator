<Window
    x:Class="Translator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:Translator.Properties"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    Title="{x:Static p:Resources.MainWindow_Title}"
    Width="650"
    Height="Auto"
    MinHeight="100"
    MaxHeight="350"
    Deactivated="Window_Deactivated"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style
            x:Key="FlatButtonStyle"
            BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
            TargetType="Button" />
    </Window.Resources>

    <Border BorderBrush="Black" BorderThickness="1">

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <tb:TaskbarIcon
                IconSource="/icons/sidebar_sites_earth_world_globe_20458_all.ico"
                MenuActivation="LeftOrRightClick"
                ToolTipText="{x:Static p:Resources.TrayIcon_TooltipText}"
                Visibility="Visible">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuItemTranslate_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_Translate}" />
                        <Separator />
                        <MenuItem Click="MenuItemExit_Click" Header="{x:Static p:Resources.TrayIcon_MenuItem_Exit}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <Grid
                Grid.Row="0"
                Margin="0,10,20,0"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Name="QueryTextBox"
                    Grid.Column="0"
                    Height="25"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    ToolTip="{x:Static p:Resources.QueryTextBox_Tooltip}" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="5,0,0,0"
                    Click="SearchButton_Click"
                    Style="{StaticResource FlatButtonStyle}"
                    ToolTip="{x:Static p:Resources.SearchButton_Tooltip}">
                    <Image Source="/icons/Search_find_locate_1542_x32.ico" />
                </Button>
            </Grid>

            <StackPanel
                Name="LoadingIndicator"
                Grid.Row="1"
                VerticalAlignment="Center">

                <TextBlock
                    Margin="0,5,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontStyle="Italic"
                    Text="{x:Static p:Resources.LoadingTextBlock_Text}" />
            </StackPanel>

            <WebBrowser
                Name="WebBrowser"
                Grid.Row="1"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                Visibility="Visible" />
        </Grid>
    </Border>
</Window>
